# ═══════════════════════════════════════════════════════════════
# AXIOMA v0.7.0 — CONFIGURACIÓN (Plantilla Pública)
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa valores reales
# NUNCA subas .env con valores reales a Git
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# 🔑 CLAVES DE API EXTERNAS (DEJAR VACÍO SI NO SE USAN)
# ═══════════════════════════════════════════════════════════════

# Búsqueda Web (múltiples proveedores con fallback)
# ⚠️ Rotar keys periódicamente. Nunca commitear valores reales.
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=
BRAVE_API_KEY=

# Noticias
NEWS_API_KEY=

# ═══════════════════════════════════════════════════════════════
# 🤖 CONFIGURACIÓN DE MODELOS OLLAMA
# ═══════════════════════════════════════════════════════════════

# Modelos por tipo de tarea (nombres exactos de `ollama list`)
# ✅ Stack consolidado — 3 modelos en lugar de 5 (v0.6.7+)
#   - qwen3:8b        → chat general + razonamiento complejo
#   - qwen2.5-coder:7b → código (venció en benchmark de calidad) + fallback + validador
#   - qwen3-vl:4b     → visión/multimodal (único VLM activo)
# ✅ deepseek-r1:8b fue DESCARTADO (benchmark_code_results.md) — no instalar.
# ✅ Modelos ELIMINADOS (no instalar):
#   - huihui_ai/qwen2.5-abliterate:7b  (consolidado en qwen3:8b)
#   - axioma-code:latest               (consolidado en qwen2.5-coder:7b)
#   - qwen2.5:3b                       (consolidado en qwen3:8b)
#   - gemma4:e4b                       (inestable en CPU, reemplazado por qwen3-vl:4b)
#   - moondream:v2                     (fallo silencioso >256px)
LLM_DEFAULT_MODEL=qwen3:8b
LLM_CODE_MODEL=qwen2.5-coder:7b
LLM_VISION_MODEL=qwen3-vl:4b
LLM_VISION_FALLBACK_MODEL=
LLM_EMBED_MODEL=BAAI/bge-m3
LLM_JUDGE_MODEL=

# Cadena de fallback (orden de prioridad ante fallo)
# ⚠️ llm_fallback_1 usa el mismo modelo de código (qwen2.5-coder:7b) —
#    especialista de código como juez general. Si el circuit breaker abre
#    por fallo de código específicamente, cae en el mismo modelo; para
#    fallos de chat general sí provee resiliencia real vs qwen3:8b.
LLM_FALLBACK_1=qwen2.5-coder:7b
LLM_FALLBACK_2=

# Conexión a Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# ═══════════════════════════════════════════════════════════════
# ⏱️ TIMEOUTS PROGRESIVOS (optimizados para hardware limitado)
# ═══════════════════════════════════════════════════════════════

# ✅ Vision timeout ajustado a 150s (margen seguridad sobre ~111s en CPU)
# Rango validado por pydantic: 60–300s
OLLAMA_TIMEOUT_STANDARD=45
OLLAMA_TIMEOUT_FIRST_LOAD=65
OLLAMA_TIMEOUT_VISION=150
OLLAMA_TIMEOUT_VISION_FALLBACK=150
OLLAMA_TIMEOUT_EMBED=35
SEARCH_TIMEOUT=30
OLLAMA_TIMEOUT_OPTIMIZER=90

# ═══════════════════════════════════════════════════════════════
# 📷 VISION / SCREEN CAPTURE
# ═══════════════════════════════════════════════════════════════

# ✅ Resolución nativa 4K (3840×2160)
# El resize a 800×600 destruía legibilidad de texto en IDEs, HiDPI y multi-monitor.
# qwen3-vl:4b probado exitosamente en 1920×1080 nativo — sin resize.
# Rangos validados: width 640–7680, height 480–4320
VISION_MODEL_SELECTOR=auto
VISION_CAPTURE_MAX_WIDTH=3840
VISION_CAPTURE_MAX_HEIGHT=2160
VISION_JPEG_QUALITY=82

# ═══════════════════════════════════════════════════════════════
# 🔒 SEGURIDAD Y SANDBOX
# ═══════════════════════════════════════════════════════════════

# Ejecución de código generado (sandbox)
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_TIMEOUT=30
MAX_CODE_LENGTH=1000

# Claves de seguridad (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
BACKUP_ENCRYPTION_KEY=
SESSION_TIMEOUT=3600

# ═══════════════════════════════════════════════════════════════
# 🧠 MEMORIA Y ALMACENAMIENTO
# ═══════════════════════════════════════════════════════════════

# Memoria persistente
# ✅ ENABLE_MEMORY: activa/desactiva el gateway de memoria (sinónimo funcional de MEMORY_ENABLED)
ENABLE_MEMORY=true
MEMORY_ENABLED=true
MEMORY_CAPACITY=100
MEMORY_CONTEXT_WINDOW=5

# Caché de embeddings
EMBEDDING_CACHE_MAX_AGE_DAYS=30
AUTO_CLEAN_EMBEDDINGS_ON_STARTUP=true

# ✅ RUTAS: Las variables de rutas están COMENTADAS intencionalmente
# para que settings.py use sus default_factory correctos.
# Solo descomenta si necesitas rutas personalizadas.
# BASE_DIR=/ruta/a/axioma
# DATA_DIR=/ruta/a/axioma/data
# LOGS_DIR=/ruta/a/axioma/logs
# CONFIG_DIR=/ruta/a/axioma/config
# VECTOR_DB_PATH=/ruta/a/axioma/data/memory
# DB_PATH=/ruta/a/axioma/data/axioma.db

# ═══════════════════════════════════════════════════════════════
# 📊 MONITOREO Y LOGGING
# ═══════════════════════════════════════════════════════════════

# Logging general
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
ENABLE_FILE_LOGGING=true

# Monitoreo de enrutamiento
ROUTING_LOG_ENABLED=true
ROUTING_LOG_FILE=routing_decisions.log
ROUTING_LOG_MAX_SIZE_MB=50

# Debug específico
DEBUG_GUI_ACTIONS=false

# ═══════════════════════════════════════════════════════════════
# ✨ FORMATO DE SALIDA Y AUTO-CORRECCIÓN
# ═══════════════════════════════════════════════════════════════

# Formato estilo Claude (minimalista para código)
FORMAT_CLAUDE_STYLE=true

# Auto-crítica heurística (sin LLM adicional)
ENABLE_AUTO_CRITIQUE=true

# Auto-corrección de respuestas
ENABLE_AUTO_CORRECTION=true
AUTO_CORRECTION_VALIDATION_TIMEOUT=10
VALIDATION_THRESHOLD=0.7

# ═══════════════════════════════════════════════════════════════
# 🌐 INTERFAZ Y LOCALIZACIÓN
# ═══════════════════════════════════════════════════════════════

# Idioma de interfaz y respuestas
LANG=es

# Nivel de autonomía del agente ("low", "medium", "high")
AUTONOMY_LEVEL=high

# Modo verbose (detalle en respuestas)
VERBOSE=false

# Geolocalización
DEFAULT_LOCATION=Córdoba, Argentina
DEFAULT_TIMEZONE=America/Argentina/Cordoba
ENABLE_IP_GEOLOCATION=true
GEOLOCATOR_CACHE_TTL=3600

# ═══════════════════════════════════════════════════════════════
# 📈 OBSERVABILIDAD (Phoenix Tracing — Opcional)
# ═══════════════════════════════════════════════════════════════

# Arize Phoenix — Requiere: phoenix serve --port 6006
ENABLE_PHOENIX_TRACING=false
PHOENIX_ENDPOINT=http://127.0.0.1:6006

# ═══════════════════════════════════════════════════════════════
# 🖥 GUI Y SERVIDOR WEB (NiceGUI)
# ═══════════════════════════════════════════════════════════════

HOST=127.0.0.1
PORT=8000
DEBUG=false
RELOAD=false

# Notificaciones en chat GUI
GUI_CHAT_NOTIFICATIONS_ENABLED=true

# Ventanas emergentes de fallback (default: false - solo chat)
GUI_MODAL_FALLBACK_ENABLED=false

# ═══════════════════════════════════════════════════════════════
# 📦 LÍMITES DE RECURSOS
# ═══════════════════════════════════════════════════════════════

# Monitoreo de recursos del sistema
MAX_RAM_USAGE_PERCENT=80.0
MAX_CPU_USAGE_PERCENT=90.0
MAX_CONCURRENT_TASKS=2

# ✅ CALIBRACIÓN (2026-08-29): factor de footprint real del modelo cargado
# (KV cache + buffers de Ollama) sobre required_gb de hardware_fit.
# Medido con tools/benchmark_calibration.py contra el RSS real de Ollama
# (serve + runner llama-server): 1.10 en este hardware (default 1.0).
# Sin ajuste, MemoryGuard subestima la RAM real → riesgo de OOM.
MEMORY_GUARD_OVERHEAD_RATIO=1.10

# ═══════════════════════════════════════════════════════════════
# 👤 CAPA 2 — IDENTIDAD DE USUARIO (plan_memory, 2026-08-31)
# Aísla la memoria por usuario (retrieval cross-sesión): cada usuario solo
# recupera SUS mensajes. saintwick es el usuario root (admin); los usuarios
# futuros serán "user" (sin privilegios).
# ═══════════════════════════════════════════════════════════════
# Tu identidad: se crea desde la interfaz la primera vez (dejala vacía hasta entonces).
AXIOMA_USER_ID=
AXIOMA_USER_ROLE=user
CROSS_SESSION_LIMIT=3
CROSS_SESSION_MIN_SIMILARITY=0.5


# ═══════════════════════════════════════════════════════════════
# 🌐 BÚSQUEDA WEB
# ═══════════════════════════════════════════════════════════════

# Motor de búsqueda preferido
WEB_SEARCH_ENGINE=tavily
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT=10

# ═══════════════════════════════════════════════════════════════
# ⏱️ TIMEOUTS ESPECÍFICOS
# ═══════════════════════════════════════════════════════════════

# Operaciones de backup/restore (hardware limitado)
BACKUP_TIMEOUT_SECONDS=300
RESTORE_TIMEOUT_SECONDS=600
AUTO_REVIEW_TIMEOUT_SECONDS=300

# ═══════════════════════════════════════════════════════════════
# 🧪 AGENTES
# ═══════════════════════════════════════════════════════════════

MAX_RETRIES=2
ROUTE_CACHE_TTL=300
VERIFY_MODELS_ON_STARTUP=true

# ═══════════════════════════════════════════════════════════════
# 🔄 CHUNKED GENERATION
# ═══════════════════════════════════════════════════════════════

# ✅ v0.7.5 (ISSUE-099): apaga el "thinking" en el chat. Medido con qwen3:8b:
# sin apagarlo, ~80% del presupuesto se va en pensar ⇒ respuestas truncadas o
# vacías (y 1,6× más lentas). poné false para volver al comportamiento viejo.
CHAT_DISABLE_THINKING=true

# ═══════════════════════════════════════════════════════════════
# 🔍 RAC — Revisión Axioma Completa (/rac [completa|parcial])
# ═══════════════════════════════════════════════════════════════
# ✅ v0.7.5: presupuesto global de la corrida. TIEMPO MEDIDO en este equipo (no
# estimado): un ciclo COMPLETO cuesta
#   · parcial (src/core + src/domain): 130 bloques → 113 min de prefill + 164 min de
#     generación al máximo = 277 min (4,6 h); ~154 min con respuestas típicas.
#   · completa (src + config): 577 bloques → 1233 min (20,5 h) en el peor caso ⇒
#     necesita VARIAS corridas.
# El avance se guarda tras CADA archivo (data/rac_state.json) y la corrida siguiente
# CONTINÚA donde quedó (los ciclos se cierran solos al completar el alcance).
AXIOMA_RAC_MAX_MINUTES=45   # 300 cubre un ciclo `parcial` completo en el peor caso
# ⚠️ Ojo: durante la RAC el candado de VRAM queda tomado (los cambios de modelo
# esperan o rebotan hasta VRAM_LOCK_WAIT_TIMEOUT). Es a propósito.
# Timeout por bloque (600 s = profundidad completa; con 240 s se recortaba la
# respuesta en 23 de 26 bloques medidos).
AXIOMA_RAC_TIMEOUT=600
# Pausa de purga de VRAM: ahora sólo se aplica a los lotes CON fallos (era tiempo
# muerto: medido, quitarla del todo baja el total de 52 a 50 min).
AXIOMA_RAC_BATCH_PAUSE=45
AXIOMA_RAC_COOLDOWN=3

CHUNKED_GENERATION_ENABLED=true
CHUNK_MAX_TOKENS=1800
CHUNK_OVERLAP_LINES=15
CHUNK_MAX_ITERATIONS=20
# ✅ v0.7.5 (ISSUE-074/A3b): tope TOTAL de tokens por archivo generado.
# 20 iteraciones × 1800 = 36.000 tokens (≈76 min a 7,9 tok/s en CPU) no es un
# tope usable: con 8192 el peor caso baja a ~1037 s, por encima del p95 real
# (578 s) y 2× el máximo observado (879 s) en data/traces.db.
CHUNK_TOTAL_TOKEN_BUDGET=8192
CHUNKED_LINES_THRESHOLD=150

# ═══════════════════════════════════════════════════════════════
# 📝 NOTAS DE CONFIGURACIÓN
# ═══════════════════════════════════════════════════════════════
#
# 🔒 SEGURIDAD:
#   - Este archivo NO debe subirse a repositorios públicos
#   - Agrega .env a .gitignore
#   - Rota las API keys periódicamente
#
# ⚙ HARDWARE LIMITADO:
#   - Los timeouts están optimizados para hardware de Córdoba
#   - Ajustar OLLAMA_TIMEOUT según tu CPU/RAM
#
# 🧪 DESARROLLO:
#   - VERBOSE=true para ver detalles de decisiones
#   - ENABLE_PHOENIX_TRACING=true para auditoría de ruteo
#   - DEBUG_GUI_ACTIONS=true para debug de callbacks
#
# 🚀 PRODUCCIÓN:
#   - VERBOSE=false (respuestas concisas)
#   - ENABLE_PHOENIX_TRACING=false (sin overhead)
#   - CODE_EXECUTION_ENABLED=true (con sandbox)
#
# 🔄 STACK ACTUAL (sincronizado con settings.py + models.yaml v0.6.7):
#
#   Modelos activos (ollama list):
#   - qwen3:8b         (5.2 GB)  — chat general + razonamiento
#   - qwen2.5-coder:7b (4.7 GB)  — código + fallback + validador
#   - qwen3-vl:4b      (3.3 GB)  — visión/multimodal
#   - BAAI/bge-m3      (embeddings, vía sentence-transformers)
#
#   Mapeo en settings.py:
#   - LLM_DEFAULT_MODEL  → qwen3:8b         (chat, default)
#   - LLM_CODE_MODEL     → qwen2.5-coder:7b (venció en benchmark de calidad)
#   - LLM_VISION_MODEL   → qwen3-vl:4b      (único VLM activo)
#   - LLM_FALLBACK_1     → qwen2.5-coder:7b (especialista como juez general)
#   - LLM_JUDGE_MODEL    → ""               (juez externo eliminado en v0.6.2)
#   - LLM_FALLBACK_2     → ""               (desactivado en fase0_stabilizer)
#
#   Modelos eliminados (NO instalar):
#   - deepseek-r1:8b                   (descartado por benchmark)
#   - huihui_ai/qwen2.5-abliterate:7b  (consolidado en qwen3:8b)
#   - axioma-code:latest               (consolidado en qwen2.5-coder:7b)
#   - qwen2.5:3b                       (consolidado en qwen3:8b)
#   - gemma4:e4b                       (inestable en CPU, reemplazado por qwen3-vl:4b)
#   - moondream:v2                     (fallo silencioso >256px)
#
# ═══════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════
# 🚀 MULTI-QUERY LIGERO — v0.6.8
# ═══════════════════════════════════════════════════════════════
# Mejora de recall sin LLM (src/memory/multi_query.py):
# expansión determinística + UN batch BGE-M3 + fusión RRF.
# Adaptado a CPU-only: costo extra +0-200ms por query.
# TODOS los valores son opcionales (los defaults están en settings.py)
MULTI_QUERY_ENABLED=true
MULTI_QUERY_MAX_VARIANTS=4
MULTI_QUERY_MIN_LENGTH=30
MULTI_QUERY_RRF_K=60
MULTI_QUERY_STORE_L3_VARIANTS=true
